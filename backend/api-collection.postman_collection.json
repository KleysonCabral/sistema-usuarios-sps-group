{
	"info": {
		"name": "User Management API",
		"description": "API para gerenciamento de usuários com autenticação JWT",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Login",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"admin@spsgroup.com.br\",\n  \"password\": \"1234\"\n}"
				},
				"url": {
					"raw": "http://localhost:3005/auth/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "3005",
					"path": [
						"auth",
						"login"
					]
				}
			}
		},
		{
			"name": "Listar Usuários",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "http://localhost:3005/users",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "3005",
					"path": [
						"users"
					]
				}
			}
		},
		{
			"name": "Criar Usuário",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@exemplo.com\",\n  \"type\": \"user\",\n  \"password\": \"123456\"\n}"
				},
				"url": {
					"raw": "http://localhost:3005/users",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "3005",
					"path": [
						"users"
					]
				}
			}
		},
		{
			"name": "Buscar Usuário",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "http://localhost:3005/users/1",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "3005",
					"path": [
						"users",
						"1"
					]
				}
			}
		},
		{
			"name": "Atualizar Usuário",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"João Santos\",\n  \"email\": \"joao.santos@exemplo.com\",\n  \"type\": \"user\",\n  \"password\": \"novaSenha123\"\n}"
				},
				"url": {
					"raw": "http://localhost:3005/users/2",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "3005",
					"path": [
						"users",
						"2"
					]
				}
			}
		},
		{
			"name": "Deletar Usuário",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "http://localhost:3005/users/2",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "3005",
					"path": [
						"users",
						"2"
					]
				}
			}
		}
	]
}
